{
  "version": "1.0.0",
  "description": "规范设计 · 可复用语义变量。原站观察值见 research/reference-measurements.json。",
  "base": {
    "font-sans": "Inter, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif",
    "font-mono": "'SFMono-Regular', Consolas, 'Liberation Mono', monospace",
    "text-xs": "12px", "text-sm": "13px", "text-base": "14px", "text-lg": "17px",
    "title-sm": "20px", "title-md": "30px", "title-lg": "38px",
    "space-1": "4px", "space-2": "8px", "space-3": "12px", "space-4": "16px",
    "space-6": "24px", "space-8": "32px", "space-12": "48px", "space-16": "64px",
    "radius-xs": "4px", "radius-sm": "6px", "radius-md": "8px", "radius-lg": "12px", "radius-pill": "999px",
    "control-sm": "28px", "control-md": "34px", "control-lg": "40px",
    "duration-fast": "160ms", "duration-normal": "240ms", "duration-enter": "300ms", "duration-slow": "750ms",
    "ease-out": "cubic-bezier(.19, 1, .22, 1)", "ease-spring": "cubic-bezier(.34, 1.56, .64, 1)",
    "z-menu": "30", "z-toast": "100", "sidebar-width": "192px",
    "accent-soft": "color-mix(in srgb, var(--ui-accent-mark) 11%, var(--ui-surface))",
    "focus-ring": "0 0 0 3px color-mix(in srgb, var(--ui-accent-mark) 28%, transparent)"
  },
  "light": {
    "canvas": "#fcfdfd", "surface": "#ffffff", "surface-tint": "#f4f5f8", "surface-hover": "#f0f3f6",
    "ink": "#1a2035", "text": "#515b72", "muted": "#69758a", "faint": "#8a93a5", "inverse": "#ffffff",
    "line": "#e8ecf1", "line-strong": "#d4dbe5", "danger": "#c34150", "danger-soft": "#fff0f2",
    "warning": "#9b672c", "warning-soft": "#fff6e9", "success": "#277e59", "success-soft": "#edf8f1",
    "shadow-control": "0 2px 4px #12376914, 0 1px 1px #1237690a, 0 0 0 1px #12376914",
    "shadow-float": "0 8px 32px #12376929, 0 0 0 1px #12376914",
    "backdrop": "#19223826", "floral-opacity": ".56"
  },
  "dark": {
    "canvas": "#1b2030", "surface": "#22283b", "surface-tint": "#2b3145", "surface-hover": "#30374d",
    "ink": "#edf0f8", "text": "#c0c7d9", "muted": "#a0abc2", "faint": "#8995ac", "inverse": "#1b2030",
    "line": "#ffffff14", "line-strong": "#ffffff2b", "danger": "#ff9aaa", "danger-soft": "#432b39",
    "warning": "#edc58c", "warning-soft": "#3c342d", "success": "#7ed8ac", "success-soft": "#223f37",
    "shadow-control": "0 2px 4px #0000001f, 0 0 0 1px #ffffff1a",
    "shadow-float": "0 12px 40px #00000055, 0 0 0 1px #ffffff1a",
    "backdrop": "#0a102866", "floral-opacity": ".12"
  },
  "mint": { "accent": "#277d5c", "accent-mark": "#58b68e" },
  "blue": { "accent": "#087eb9", "accent-mark": "#00a0ff" }
}
