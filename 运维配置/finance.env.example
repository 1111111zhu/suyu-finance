# Copy assignments to private 0600 files outside Git; never print compose config.
# Compose invocation environment: absolute private file paths
FINANCE_DB_ENV_FILE=/etc/suyu-finance/database.env
FINANCE_RUNTIME_ENV_FILE=/etc/suyu-finance/runtime.env
FINANCE_MIGRATION_ENV_FILE=/etc/suyu-finance/migration.env
FINANCE_WECOM_SECRET_FILE=/etc/suyu-finance/wecom.secret
FINANCE_BACKUP_ROOT=/var/backups/suyu-finance

# database.env (bootstrap admin credentials ONLY in postgres)
POSTGRES_USER=finance_bootstrap
POSTGRES_PASSWORD=REPLACE_STRONG_SECRET
RD_DB_NAME=rd_finance
PAYROLL_DB_NAME=suyu_payroll
RD_DB_OWNER_PASSWORD=REPLACE_STRONG_SECRET
RD_DB_RUNTIME_PASSWORD=REPLACE_STRONG_SECRET
PAYROLL_DB_OWNER_PASSWORD=REPLACE_STRONG_SECRET
PAYROLL_RUNTIME_PASSWORD=REPLACE_STRONG_SECRET

# runtime.env (URL-encode passwords)
RD_DATABASE_URL=postgresql://rd_runtime:REPLACE_URL_ENCODED_SECRET@postgres:5432/rd_finance
DATABASE_URL=postgresql://payroll_runtime:REPLACE_URL_ENCODED_SECRET@postgres:5432/suyu_payroll
PAYROLL_PUBLIC_ORIGIN=https://finance.example.com
FINANCE_STORAGE_DIR=/app/storage
RD_STORAGE_DIR=/app/storage/rd
SUYU_PUBLIC_ORIGIN=https://finance.example.com
WECOM_CORP_ID=wwREPLACE_WITH_CORP_ID
WECOM_APP_SECRET_FILE=/run/secrets/wecom_app_secret
WECOM_MANAGER_TAG_ID=REPLACE_WITH_ACTUAL_TAG_ID
WECOM_FINANCE_DEPARTMENT_ID=REPLACE_WITH_ACTUAL_DEPARTMENT_ID

# migration.env (never mounted in the web service)
RD_DATABASE_MIGRATION_URL=postgresql://rd_owner:REPLACE_URL_ENCODED_SECRET@postgres:5432/rd_finance
DATABASE_MIGRATION_URL=postgresql://payroll_owner:REPLACE_URL_ENCODED_SECRET@postgres:5432/suyu_payroll
RD_DB_RUNTIME_USER=rd_runtime
PAYROLL_RUNTIME_ROLE=payroll_runtime
