# Copy to a private file outside the repository. Tools do not auto-load this file.
# Container DB address: payroll-db. Native API address: 127.0.0.1.
DATABASE_URL=postgresql://payroll_runtime:REPLACE_WITH_RUNTIME_SECRET@payroll-db:5432/payroll
# EXACT website origin, no trailing slash or path. Production requires HTTPS.
PAYROLL_PUBLIC_ORIGIN=https://finance.example.com
PAYROLL_API_PORT=3002
# WeCom is optional until an administrator supplies an existing read-only
# Contacts application with appropriate visible departments. Keep its Secret
# in a private 0600 file outside this repository; never put it in browser JS.
WECOM_CORP_ID=
WECOM_SECRET_FILE=
# Exact trusted Nginx connection IPs only. Native example: 127.0.0.1,::1.
# In Docker, identify the dedicated network gateway seen by the API, then set it.
# Empty means forwarded client IP headers are ignored.
PAYROLL_TRUSTED_PROXIES=
# Native local development only: NODE_ENV=development and localhost HTTP origin.
NODE_ENV=production
# Do not add migration/admin credentials or PAYROLL_ALLOW_DEMO to this service.

# Optional read-only Enterprise WeChat directory. Keep the Secret in a private
# server-side file; the payroll website and browser never receive it.
# The application must be allowed to read its selected WeCom member scope.
WECOM_DIRECTORY_SYNC_ENABLED=0
WECOM_CORP_ID=wwREPLACE_WITH_CORP_ID
WECOM_APP_SECRET_FILE=/run/secrets/wecom_app_secret
WECOM_DIRECTORY_SYNC_INTERVAL_SECONDS=21600
WECOM_DIRECTORY_MAX_MEMBERS=10000
