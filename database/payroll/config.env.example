# EXAMPLE ONLY. Tools never load .env automatically. Replace every placeholder.
# Bootstrap administrator: used only by the PostgreSQL container/role setup.
PAYROLL_DB_NAME=payroll
PAYROLL_DB_PORT=5432
PAYROLL_DB_ADMIN_USER=payroll_admin
PAYROLL_DB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_SECRET

# Provision separate login roles before migration/application use.
# payroll_owner owns schema payroll and public.payroll_schema_migrations.
# payroll_runtime gets only required DML/sequence privileges, never DDL/CREATEDB.
# URL-encode passwords. Do not put URLs in command-line arguments or commit them.
DATABASE_MIGRATION_URL=postgresql://payroll_owner:REPLACE_WITH_OWNER_SECRET@127.0.0.1:5432/payroll
DATABASE_URL=postgresql://payroll_runtime:REPLACE_WITH_RUNTIME_SECRET@127.0.0.1:5432/payroll

# Backup/restore use libpq environment variables, NOT database URLs.
# PGPASSFILE must point to a private 0600 file provisioned outside the repository.
# For restore, override PGUSER with an administrator that has CREATEDB and can
# SET ROLE to --owner. Provision the owner/runtime roles before restoring ACLs.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=payroll_owner
PGDATABASE=payroll
PGPASSFILE=/absolute/private/path/pgpass
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10

# Report retention candidates only; backups are never deleted automatically.
PAYROLL_BACKUP_RETENTION_DAYS=30
