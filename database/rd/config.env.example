# EXAMPLE ONLY. Do not use one all-purpose environment file in production.
# Keep the three private files below outside the repository, each with mode 0600.

# /etc/suyu-finance/rd-compose.env — used only by Docker Compose
RD_DB_NAME=rd_finance
RD_DB_PORT=5433
RD_DB_ADMIN_USER=rd_admin
RD_DB_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Used only for the one-time role creation command, then remove this file.
RD_DB_OWNER_USER=rd_owner
RD_DB_OWNER_PASSWORD=REPLACE_WITH_OWNER_SECRET
RD_DB_RUNTIME_USER=rd_runtime
RD_DB_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
RD_DATABASE_ADMIN_URL=postgresql://rd_admin:REPLACE_WITH_ADMIN_SECRET@127.0.0.1:5433/rd_finance

# /etc/suyu-finance/rd-migrate.env — used only for migration and grants, then remove it.
RD_DATABASE_MIGRATION_URL=postgresql://rd_owner:REPLACE_WITH_OWNER_SECRET@127.0.0.1:5433/rd_finance

# /etc/suyu-finance/rd-runtime.env — the only database setting available to the web service
RD_DATABASE_URL=postgresql://rd_runtime:REPLACE_WITH_RUNTIME_SECRET@127.0.0.1:5433/rd_finance
