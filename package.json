{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "sync:policies": "node 自动化脚本/sync-policies.mjs && node 自动化脚本/write-policy-applications.mjs",
    "presync:policies": "npm run test:policy",
    "check:policy-integrity": "node 自动化脚本/check-policy-integrity.mjs",
    "check:policy-links": "node 自动化脚本/check-policy-links.mjs",
    "test:policy": "node --test 自动化测试/policy-matcher.test.mjs",
    "sync:company-profile": "node 自动化脚本/sync-company-profile.mjs",
    "test:company-profile": "node --test 自动化测试/company-profile.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node database/payroll/migrate.mjs migrate",
    "db:status": "node database/payroll/migrate.mjs status",
    "db:bootstrap": "node database/payroll/admin.mjs bootstrap",
    "db:runtime-role": "node database/payroll/admin.mjs runtime-role",
    "db:api-grants": "node database/payroll/admin.mjs api-grants",
    "db:seed:demo": "node database/payroll/demo.mjs",
    "test:db": "node --test 自动化测试/payroll-db-fields.test.mjs 自动化测试/payroll-db-tools.test.mjs",
    "test:db:integration": "node --test 自动化测试/payroll-db.integration.test.mjs",
    "payroll:api": "node server/payroll/start.mjs",
    "test:payroll-api": "node --test 自动化测试/payroll-api.test.mjs 自动化测试/payroll-auth.test.mjs 自动化测试/payroll-cloud.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.2.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
