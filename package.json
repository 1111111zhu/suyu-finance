{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "sync:policies": "node scripts/sync-policies.mjs && node scripts/write-policy-applications.mjs",
    "presync:policies": "npm run test:policy",
    "check:policy-integrity": "node scripts/check-policy-integrity.mjs",
    "check:policy-links": "node scripts/check-policy-links.mjs",
    "test:policy": "node --test tests/policy-matcher.test.mjs tests/policy-feed.test.mjs tests/document-text.test.mjs tests/policy-links.test.mjs tests/policy-integrity.test.mjs tests/policy-navigation.test.mjs",
    "sync:company-profile": "node scripts/sync-company-profile.mjs",
    "test:company-profile": "node --test tests/company-profile.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.2.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
